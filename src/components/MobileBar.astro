---
import { url } from '../lib/url';
import { practice } from '../lib/practice';
---
<div class:list={['mobile-bar', { 'mobile-bar--single': !practice.phone }]} role="region" aria-label="Brze akcije">
  {practice.phone && <a class="btn btn--secondary" href={`tel:${practice.phone.e164}`} data-nap="phone">Pozovite</a>}
  <a class="btn btn--primary" href={url('/zakazivanje')}>Zakažite termin online</a>
</div>
<style>
  .mobile-bar {
    position: fixed; inset: auto 0 0 0; z-index: var(--z-sticky); display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: var(--space-xs);
    padding: var(--space-sm) var(--space-md) calc(var(--space-sm) + env(safe-area-inset-bottom)); background: var(--color-paper);
    border-top: var(--rule-hair) solid var(--color-rule);
  }
  .mobile-bar--single { grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 64rem) { .mobile-bar { display: none; } }
</style>
