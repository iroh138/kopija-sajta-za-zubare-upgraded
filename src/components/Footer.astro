---
import { url } from '../lib/url';
import { getCollection } from 'astro:content';
import { practice, addressLine, hoursRows } from '../lib/practice';
import Logo from './Logo.astro';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const hours = hoursRows();
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <div class="site-footer__mast">
      <a href={url('/')} class="site-footer__logo" aria-label={`${practice.name}, početna`}><Logo size="lg" /></a>
      <p class="site-footer__line">{practice.tagline}</p>
    </div>

    <div class="site-footer__grid">
      <div>
        <h2 class="site-footer__label">Adresa</h2>
        <p><a href={practice.mapsUrl} rel="noopener" data-nap="address">{addressLine()}</a></p>
      </div>
      <div>
        <h2 class="site-footer__label">Radno vreme</h2>
        <ul class="hours-list" data-nap="hours">
          {hours.map((h) => <li><span>{h.day}</span> <span>{h.text}</span></li>)}
        </ul>
        {practice.bookingOnly && <p class="muted">Samo uz prethodno zakazivanje.</p>}
      </div>
      <div>
        <h2 class="site-footer__label">Kontakt</h2>
        <p>
          {practice.phone && <><a href={`tel:${practice.phone.e164}`} data-nap="phone">{practice.phone.display}</a><br /></>}
          <a href={`mailto:${practice.email}`}>{practice.email}</a><br />
          <a href={url('/zakazivanje')}>Zakazivanje online</a>
        </p>
      </div>
      <nav class="site-footer__nav" aria-label="Meni u podnožju">
        <ul>
          <li><a href={url('/')}>Početna</a></li>
          <li><a href={url('/o-nama')}>O nama</a></li>
          <li><a href={url('/pitanja')}>Pitanja i odgovori</a></li>
          <li><a href={url('/kontakt')}>Kontakt</a></li>
          <li><a href={url('/privatnost')}>Privatnost</a></li>
        </ul>
        <ul>
          <li><a href={url('/usluge')}>Usluge</a></li>
          {services.map((s) => <li><a href={url(`/usluge/${s.id}`)}>{s.data.shortTitle ?? s.data.title}</a></li>)}
        </ul>
      </nav>
    </div>

    <p class="site-footer__copy">© {year} {practice.legalName}</p>
  </div>
</footer>
<style>
  /* footer: a mast, the wordmark and the motto over address, hours, contact and the links. */
  .site-footer { background: var(--color-paper); border-top: var(--rule-hair) solid var(--color-rule); padding-block: var(--section-gap-s) var(--space-xl); margin-bottom: var(--space-3xl); }
  @media (min-width: 64rem) { .site-footer { margin-bottom: 0; } }
  .site-footer a { color: var(--color-ink); text-decoration: none; }
  .site-footer a:hover { color: var(--color-accent); text-decoration: underline; }
  .site-footer__mast { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: var(--space-lg); padding-bottom: var(--space-xl); margin-bottom: var(--space-xl); border-bottom: var(--rule-hair) solid var(--color-rule); }
  .site-footer__logo { display: inline-block; }
  .site-footer__line { font-size: var(--text-xl); font-weight: 300; color: var(--color-ink-2); max-width: 30ch; }
  .site-footer__grid { display: grid; gap: var(--space-xl); grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr)); }
  .site-footer__label { font-family: var(--font-body); font-size: var(--text-sm); font-weight: 400; letter-spacing: 0; color: var(--color-muted); margin-bottom: var(--space-xs); }
  .hours-list { list-style: none; padding: 0; margin: 0 0 var(--space-xs); font-variant-numeric: tabular-nums; }
  .hours-list li { display: flex; justify-content: space-between; gap: var(--space-md); max-width: 16rem; padding-block: var(--space-3xs); }
  .site-footer__nav { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--space-lg); align-content: start; grid-column: span 1; }
  @media (min-width: 64rem) { .site-footer__nav { grid-column: span 2; } }
  .site-footer__nav ul { list-style: none; padding: 0; margin: 0; }
  @media (max-width: 30rem) { .site-footer__nav { grid-template-columns: minmax(0, 1fr); } }
  .site-footer__nav a { display: inline-flex; min-height: 36px; align-items: center; }
  .site-footer__copy { margin-top: var(--space-2xl); font-size: var(--text-sm); color: var(--color-muted); }
</style>
