---
interface Props { title: string; summary: string; href: string; headingLevel?: 'h2' | 'h3' }
const { title, summary, href, headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
---
<article class="card service-card">
  <H class="service-card__title"><a href={href}>{title}</a></H>
  <p>{summary}</p>
  <span class="service-card__more" aria-hidden="true">Detaljnije</span>
</article>
<style>
  .service-card { position: relative; display: flex; flex-direction: column; gap: var(--space-xs); padding: var(--space-lg); transition: border-color var(--dur-short) var(--ease-out); }
  .service-card:hover { border-color: var(--color-ink); }
  .service-card__title { font-size: var(--text-title); }
  .service-card__title a { color: var(--color-ink); text-decoration: none; }
  /* Whole card is clickable via the heading link's ::after */
  .service-card__title a::after { content: ''; position: absolute; inset: 0; border-radius: var(--radius-card); }
  .service-card__title a:focus-visible { outline: none; }
  .service-card__title a:focus-visible::after { outline: 2px solid var(--color-focus); outline-offset: 3px; }
  .service-card p { color: var(--color-muted); flex: 1; }
  .service-card__more { font-weight: var(--weight-strong); color: var(--color-accent); }
</style>
