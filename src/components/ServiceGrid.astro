---
/**
 * The services as a menu: one row per service, the name on the left and what it covers on the right.
 * The whole row is the link (the heading's ::after). `compact` is a two-column list of names, for "other services".
 */
import { url } from '../lib/url';

interface Item { id: string; data: { title: string; shortTitle?: string; summary: string } }
interface Props { items: Item[]; compact?: boolean; numbered?: boolean }
const { items, compact = false } = Astro.props;
---
{compact ? (
  <ul class="svc-list">
    {items.map((s) => (
      <li><a href={url(`/usluge/${s.id}`)}>{s.data.shortTitle ?? s.data.title}</a></li>
    ))}
  </ul>
) : (
  <ol class="svc-rows">
    {items.map((s) => (
      <li class="svc">
        <h3 class="svc__title"><a href={url(`/usluge/${s.id}`)}>{s.data.shortTitle ?? s.data.title}</a></h3>
        <p>{s.data.summary}</p>
      </li>
    ))}
  </ol>
)}
<style>
  .svc-rows { list-style: none; padding: 0; margin: 0; border-top: var(--rule-hair) solid var(--color-rule); counter-reset: svc; }
  .svc {
    position: relative; counter-increment: svc; display: grid; gap: var(--space-xs) var(--gap-columns);
    padding-block: var(--space-lg); border-bottom: var(--rule-hair) solid var(--color-rule);
    transition: background-color var(--dur-short) var(--ease-out);
  }
  .svc:hover { background: var(--color-paper-2); }
  @media (min-width: 60rem) {
    .svc { grid-template-columns: minmax(0, 1fr) minmax(0, 4fr) minmax(0, 7fr); align-items: baseline; padding-block: var(--space-xl); }
    .svc::before { content: counter(svc); font-size: var(--text-title); font-weight: 300; color: var(--color-accent); font-variant-numeric: tabular-nums; }
  }
  .svc__title { font-size: var(--text-title); font-weight: var(--weight-strong); margin: 0; }
  .svc__title a { color: var(--color-ink); text-decoration: none; }
  .svc__title a::after { content: ''; position: absolute; inset: 0; }
  .svc__title a:focus-visible { outline: none; }
  .svc__title a:focus-visible::after { outline: 2px solid var(--color-focus); outline-offset: -2px; }
  .svc:hover .svc__title a { color: var(--color-accent); }
  .svc p { color: var(--color-muted); max-width: 60ch; }

  .svc-list { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr)); column-gap: var(--gap-columns); border-top: var(--rule-hair) solid var(--color-rule); }
  .svc-list li { border-bottom: var(--rule-hair) solid var(--color-rule); }
  .svc-list a { display: flex; align-items: center; min-height: 56px; color: var(--color-ink); text-decoration: none; font-size: var(--text-lg); }
  .svc-list a:hover { color: var(--color-accent); }
</style>
