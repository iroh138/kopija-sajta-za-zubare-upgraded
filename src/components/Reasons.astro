---
/** The practice's approach (practice.json reasons) as a definition list parted by hairlines. */
import { practice } from '../lib/practice';
interface Props { min?: string; headingLevel?: 'h3' | 'h4' }
const { min = '16rem' } = Astro.props;
---
<dl class="reasons" style={`--min:${min}`}>
  {practice.reasons.map((r) => (
    <div class="reason">
      <dt>{r.title}</dt>
      <dd>{r.body}</dd>
    </div>
  ))}
</dl>
<style>
  .reasons { margin: 0; display: grid; gap: var(--space-lg) var(--gap-columns); grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--min)), 1fr)); }
  .reason { border-top: var(--rule-hair) solid var(--color-ink); padding-top: var(--space-md); }
  .reason dt { font-size: var(--text-title); font-weight: var(--weight-strong); color: var(--color-ink); margin-bottom: var(--space-xs); }
  .reason dd { margin: 0; color: var(--color-muted); max-width: 40ch; }
</style>
