---
import { url } from '../lib/url';
import { getCollection } from 'astro:content';
import { practice } from '../lib/practice';
import Logo from './Logo.astro';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const path = Astro.url.pathname;
const here = (href: string) => (path.replace(/\/$/, '') || '/') === (url(href).replace(/\/$/, '') || '/');

// Menu groups shown in the panel (hamburger at every width, like the reference layout).
const groups = [
  {
    title: 'Ordinacija',
    links: [
      { label: 'Početna', href: '/' },
      { label: 'O nama', href: '/o-nama' },
      { label: 'Pitanja i odgovori', href: '/pitanja' },
      { label: 'Kontakt', href: '/kontakt' },
    ],
  },
  {
    title: 'Usluge',
    links: [
      ...services.map((s) => ({ label: s.data.shortTitle ?? s.data.title, href: `/usluge/${s.id}` })),
      { label: 'Sve usluge', href: '/usluge' },
    ],
  },
];
// Always-visible links on wide screens; the panel keeps the full list (all services).
const primary = [
  { label: 'Usluge', href: '/usluge' },
  { label: 'O nama', href: '/o-nama' },
  { label: 'Pitanja', href: '/pitanja' },
  { label: 'Kontakt', href: '/kontakt' },
];
---
<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href={url('/')} aria-label={`${practice.name}, početna`}>
      <Logo />
    </a>

    <nav class="primary-nav" aria-label="Brze veze">
      <ul>
        {primary.map((l) => (
          <li><a href={url(l.href)} aria-current={here(l.href) ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="site-header__actions">
      {practice.phone && (
        <a class="btn btn--secondary header-cta" href={`tel:${practice.phone.e164}`} data-nap="phone">{practice.phone.display}</a>
      )}
      <a class="btn btn--primary header-cta" href={url('/zakazivanje')}>Zakažite termin</a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-menu">
        <span class="visually-hidden">Ceo meni</span>
        <span class="menu-toggle__bars" aria-hidden="true"><span></span><span></span><span></span></span>
      </button>
    </div>
  </div>

  <nav id="site-menu" class="site-menu" aria-label="Glavni meni" hidden>
    <div class="container site-menu__grid">
      {groups.map((g) => (
        <div>
          <h2 class="site-menu__title">{g.title}</h2>
          <ul>
            {g.links.map((l) => (
              <li><a href={url(l.href)} aria-current={here(l.href) ? 'page' : undefined}>{l.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
      <div class="site-menu__contact">
        <h2 class="site-menu__title">Zakazivanje</h2>
        <p>Termini se zakazuju isključivo online.</p>
        <a class="btn btn--primary" href={url('/zakazivanje')}>Zakažite termin</a>
        <p class="site-menu__mail"><a href={`mailto:${practice.email}`}>{practice.email}</a></p>
      </div>
    </div>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const menu = document.getElementById('site-menu');
  const setOpen = (open: boolean) => {
    if (!toggle || !menu) return;
    toggle.setAttribute('aria-expanded', String(open));
    menu.hidden = !open;
    document.body.classList.toggle('menu-open', open);
  };
  // Subtle divider once the page scrolls under the sticky header.
  const header = document.querySelector<HTMLElement>('.site-header');
  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 8);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') { setOpen(false); toggle.focus(); }
  });
</script>

<style>
  /* nav: edge-aligned bar. Wordmark left, four destinations, the one action right; the full list behind a menu under 64rem. */
  .site-header { position: sticky; top: 0; z-index: var(--z-sticky-nav); background: var(--color-paper); border-bottom: var(--rule-hair) solid transparent; transition: border-color var(--dur-short) var(--ease-out); }
  .site-header.is-scrolled { border-bottom-color: var(--color-rule); }
  .site-header__inner { display: flex; align-items: center; gap: var(--space-lg); min-height: var(--header-h); }
  .brand { display: inline-flex; text-decoration: none; padding-block: var(--space-xs); flex: none; }
  .brand :global(.logo) { width: auto; height: 52px; }
  .primary-nav { display: none; margin-left: auto; }
  .primary-nav ul { list-style: none; display: flex; gap: var(--space-2xs); margin: 0; padding: 0; }
  .primary-nav a { display: inline-flex; align-items: center; min-height: 44px; padding-inline: var(--space-sm); border-radius: var(--radius-pill); color: var(--color-ink); text-decoration: none; white-space: nowrap; transition: background-color var(--dur-short) var(--ease-out); }
  .primary-nav a:hover { background: var(--color-paper-2); color: var(--color-ink); }
  .primary-nav a[aria-current='page'] { background: var(--color-paper-3); }
  .site-header__actions { display: flex; align-items: center; gap: var(--space-sm); margin-left: auto; }
  .header-cta { display: none; }

  .menu-toggle { width: 48px; height: 48px; display: grid; place-items: center; background: none; border: 0; border-radius: var(--radius-inner); cursor: pointer; color: var(--color-ink); }
  .menu-toggle:hover { background: var(--color-paper-2); }
  .menu-toggle__bars { display: grid; gap: var(--space-xs); width: 28px; }
  .menu-toggle__bars span { display: block; height: 2px; background: currentColor; transition: transform var(--dur-short) var(--ease-out), opacity var(--dur-short) var(--ease-out); }
  .menu-toggle[aria-expanded='true'] .menu-toggle__bars span:nth-child(1) { transform: translateY(10px) rotate(45deg); }
  .menu-toggle[aria-expanded='true'] .menu-toggle__bars span:nth-child(2) { opacity: 0; }
  .menu-toggle[aria-expanded='true'] .menu-toggle__bars span:nth-child(3) { transform: translateY(-10px) rotate(-45deg); }

  .site-menu { position: absolute; inset: 100% 0 auto 0; background: var(--color-paper); border-top: var(--rule-hair) solid var(--color-rule); border-bottom: var(--rule-hair) solid var(--color-rule); max-height: calc(100dvh - var(--header-h)); overflow: auto; }
  .site-menu__grid { display: grid; gap: var(--space-xl); padding-block: var(--space-xl); grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); }
  .site-menu__title { font-size: var(--text-sm); font-weight: 400; letter-spacing: 0; color: var(--color-muted); margin-bottom: var(--space-xs); }
  .site-menu ul { list-style: none; margin: 0; padding: 0; }
  .site-menu li a { display: inline-flex; align-items: center; min-height: 44px; font-size: var(--text-lg); color: var(--color-ink); text-decoration: none; }
  .site-menu li a:hover, .site-menu li a[aria-current='page'] { color: var(--color-accent); }
  .site-menu__contact p { margin-bottom: var(--space-md); }
  .site-menu__mail { margin-top: var(--space-md); }
  .site-menu__mail a { color: var(--color-ink); }
  /* Wide screens: the links show and the menu button goes; declared last so it wins. */
  @media (min-width: 64rem) {
    .primary-nav { display: block; }
    .site-header__actions { margin-left: 0; }
    .header-cta { display: inline-flex; }
    .menu-toggle { display: none; }
  }
</style>
