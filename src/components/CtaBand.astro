---
/** Closing call to action: one primary booking button in a soft panel. */
import { url } from '../lib/url';
interface Props { title: string; text?: string; href?: string; label?: string; id?: string }
const { title, text, href = '/zakazivanje', label = 'Zakažite termin online', id = 'cta-h' } = Astro.props;
---
<section class="cta-band" aria-labelledby={id}>
  <div class="container cta-band__inner">
    <div>
      <h2 id={id}>{title}</h2>
      {text && <p>{text}</p>}
    </div>
    <a class="btn btn--primary" href={url(href)}>{label}</a>
  </div>
</section>
<style>
  /* Band: a change of paper, the head on the left and the booking on the right. */
  .cta-band { background: var(--color-paper-3); padding-block: var(--section-gap-s); }
  .cta-band__inner { display: grid; gap: var(--space-xl); align-items: end; }
  .cta-band h2 { font-size: var(--text-section); font-weight: var(--display-weight); margin-bottom: var(--space-md); }
  .cta-band p { font-size: var(--text-lead); color: var(--color-ink-2); max-width: 52ch; }
  @media (min-width: 60rem) { .cta-band__inner { grid-template-columns: minmax(0, 8fr) minmax(0, 4fr); } .cta-band .btn { justify-self: end; } }
</style>
