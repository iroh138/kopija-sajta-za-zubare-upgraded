---
import { url } from '../lib/url';
interface Props { title: string; lead?: string; eyebrow?: string; crumbs?: { name: string; path: string }[] }
const { title, lead, eyebrow, crumbs = [] } = Astro.props;
---
<div class="page-header">
  <div class="container page-header__inner">
    {crumbs.length > 0 && (
      <nav aria-label="Putanja">
        <ol class="crumbs">
          {crumbs.map((c, i) => (
            <li>{i < crumbs.length - 1 ? <a href={url(c.path)}>{c.name}</a> : <span aria-current="page">{c.name}</span>}</li>
          ))}
        </ol>
      </nav>
    )}
    <h1>{title}</h1>
    {(lead || eyebrow) && <p class="lead">{eyebrow && <strong>{eyebrow}. </strong>}{lead}</p>}
    <slot />
  </div>
</div>
<style>
  /* hero: Banner on inner pages. A band of paper-2, the head at display-s, the first section above the fold. */
  .page-header { background: var(--color-paper-2); padding-block: var(--space-xl) var(--space-2xl); }
  .page-header__inner { display: grid; gap: var(--space-md); justify-items: start; }
  .page-header h1 { font-size: var(--text-display-s); max-width: 22ch; }
  .page-header .lead { max-width: 56ch; }
  .page-header :global(.btn-row) { margin-top: var(--space-xs); }
  .crumbs { list-style: none; display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-xs); padding: 0; margin: 0 0 var(--space-xs); font-size: var(--text-sm); }
  .crumbs li { display: inline-flex; align-items: center; gap: var(--space-xs); white-space: nowrap; }
  .crumbs li + li::before { content: '/'; color: var(--color-muted); }
  .crumbs a { color: var(--color-muted); text-decoration: none; display: inline-flex; min-height: 32px; align-items: center; }
  .crumbs a:hover { color: var(--color-accent); text-decoration: underline; }
  .crumbs span { color: var(--color-ink); }
</style>
