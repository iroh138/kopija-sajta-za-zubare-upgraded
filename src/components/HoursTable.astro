---
import { hoursRows, upcomingSpecialDates } from '../lib/practice';

interface Props { showSpecial?: boolean; caption?: string }
const { showSpecial = true, caption = 'Radno vreme' } = Astro.props;
const rows = hoursRows();
const special = showSpecial ? upcomingSpecialDates().slice(0, 3) : [];
---
<table class="hours-table" data-nap="hours">
  <caption class="visually-hidden">{caption}</caption>
  <tbody>
    {rows.map((r) => (
      <tr><th scope="row">{r.day}</th><td>{r.text}</td></tr>
    ))}
  </tbody>
</table>
{special.length > 0 && (
  <div class="special">
    <p class="special__title">Posebni datumi</p>
    <ul>
      {special.map((s) => <li><strong>{s.pretty}</strong> ({s.label}): {s.text}</li>)}
    </ul>
  </div>
)}
<style>
  .special { margin-top: var(--space-md); }
  .special__title { font-weight: var(--weight-strong); margin-bottom: var(--space-2xs); }
  .special ul { margin: 0; padding-left: var(--space-lg); }
</style>
