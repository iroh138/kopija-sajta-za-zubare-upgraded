---
import { url, abs } from '../lib/url';
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Reasons from '../components/Reasons.astro';
import CtaBand from '../components/CtaBand.astro';
import { breadcrumbJsonLd, ids } from '../lib/schema';
import { practice } from '../lib/practice';

const staff = (await getCollection('staff')).sort((a, b) => a.data.order - b.data.order);
const members = await Promise.all(staff.map(async (s) => ({ s, Content: (await render(s)).Content })));
const lead = staff[0] ? `${staff[0].data.honorific ? staff[0].data.honorific + ' ' : ''}${staff[0].data.name}` : '';
const crumbs = [{ name: 'Početna', path: '/' }, { name: 'O nama', path: '/o-nama' }];
const site = Astro.site ?? new URL(Astro.url.origin);
const people = staff.map((s) => ({
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': ids.person(site, s.id),
  name: s.data.name,
  url: abs(`/o-nama#${s.id}`, site),
  knowsLanguage: 'sr',
  ...(s.data.honorific ? { honorificPrefix: s.data.honorific } : {}),
  jobTitle: s.data.role,
  worksFor: { '@id': ids.practice(site) },
  ...(s.data.credentials ? { hasOccupation: { '@type': 'Occupation', name: s.data.credentials } } : {}),
  ...(s.data.photo ? { image: abs(s.data.photo.src, site) } : {}),
}));
---
<Base
  title={lead ? `O nama – ${lead}, stomatolog` : 'O nama'}
  description={`${practice.legalName} ${practice.locative}: ${practice.yearsActive} godina rada${lead ? `, ${lead}` : ''} i pristup bez bola i straha.`}
  jsonLd={[breadcrumbJsonLd(site, crumbs), ...people]}
>
  <PageHeader title="O nama" lead={practice.tagline} crumbs={crumbs} />

  {members.map(({ s, Content }) => (
    <section class="section" id={s.id}>
      <div class="container about">
        {s.data.photo && (
          <div class="arch about__photo">
            <img src={url(s.data.photo.src)} alt={s.data.photo.alt} width={s.data.photo.width} height={s.data.photo.height} loading="eager" decoding="async" />
          </div>
        )}
        <div class="about__text">
          <h2>{s.data.honorific} {s.data.name}</h2>
          <p class="about__role">{s.data.role}</p>
          <Content />
          <dl class="facts">
            <div><dt>Godina rada</dt><dd>{practice.yearsActive}</dd></div>
            <div><dt>Lokacija</dt><dd>{practice.address.city}</dd></div>
            <div><dt>Pacijenti</dt><dd>Odrasli i deca</dd></div>
          </dl>
        </div>
      </div>
    </section>
  ))}

  <section class="section section--tint" aria-labelledby="values-h">
    <div class="container">
      <h2 id="values-h" class="values__head">Kako radimo</h2>
      <Reasons min="14rem" />
    </div>
  </section>

  <CtaBand
    title="Na čemu smo najviše ponosni"
    text="Kod nas i najplašljiviji pacijenti uspeju da savladaju strah i prvi put dožive stomatologiju bez neprijatnosti. Mnogi navrate i samo da pozdrave doktorku."
  />
</Base>
<style>
  .about { display: grid; gap: var(--space-2xl); align-items: center; }
  @media (min-width: 60rem) { .about { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--space-3xl); } }
  .about__photo { aspect-ratio: 3 / 4; max-width: 32rem; width: 100%; }
  .about__text { display: grid; gap: var(--space-md); }
  .about__role { font-size: var(--text-lead); color: var(--color-accent); }
  .about__text :global(p:not(.about__role)) { font-size: var(--text-lg); max-width: 56ch; }
  .facts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--gap-columns); margin: var(--space-xl) 0 0; }
  .facts div { border-top: var(--rule-hair) solid var(--color-ink); padding-top: var(--space-md); }
  .facts dt { font-size: var(--text-sm); color: var(--color-muted); }
  .facts dd { margin: var(--space-2xs) 0 0; font-size: var(--text-xl); font-weight: var(--weight-strong); color: var(--color-ink); }
  .values__head { margin-bottom: var(--space-2xl); }
  @media (max-width: 40rem) { .facts { grid-template-columns: minmax(0, 1fr); } }
</style>
