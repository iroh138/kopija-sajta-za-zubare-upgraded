---
import { url, abs } from '../../lib/url';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import ServiceGrid from '../../components/ServiceGrid.astro';
import HoursTable from '../../components/HoursTable.astro';
import { breadcrumbJsonLd, faqJsonLd, ids } from '../../lib/schema';
import { practice, addressLine } from '../../lib/practice';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((s) => ({ params: { slug: s.id }, props: { service: s } }));
}

const { service } = Astro.props;
const { Content } = await render(service);
// Markdown links are written root-relative ("/usluge/x"); prefix the base path so they also work in the
// GitHub Pages preview (/<repo>/...). Falls back to the normal renderer if no pre-rendered HTML exists.
const bodyHtml = service.rendered?.html?.replace(/href="(\/[^"]*)"/g, (_m: string, h: string) => `href="${url(h)}"`);
const others = (await getCollection('services'))
  .filter((s) => s.id !== service.id)
  .sort((a, b) => a.data.order - b.data.order);
const path = `/usluge/${service.id}`;
const crumbs = [
  { name: 'Početna', path: '/' },
  { name: 'Usluge', path: '/usluge' },
  { name: service.data.shortTitle ?? service.data.title, path },
];
const site = Astro.site ?? new URL(Astro.url.origin);
const offer = {
  '@context': 'https://schema.org',
  '@type': 'MedicalProcedure',
  '@id': ids.service(site, service.id),
  name: service.data.title,
  ...(service.data.shortTitle ? { alternateName: service.data.shortTitle } : {}),
  description: service.data.summary,
  url: abs(path, site),
  provider: { '@id': ids.practice(site) },
};
---
<Base
  title={service.data.seoTitle ?? `${service.data.shortTitle ?? service.data.title} – ${practice.address.city}`}
  description={service.data.seoDescription ?? service.data.summary.slice(0, 158)}
  jsonLd={[breadcrumbJsonLd(site, crumbs), offer, faqJsonLd(service.data.faqs)]}
>
  <PageHeader
    eyebrow={service.data.title}
    title={`${service.data.shortTitle ?? service.data.title} ${practice.locative}`}
    lead={service.data.summary}
    crumbs={crumbs}
  >
    <div class="btn-row">
      <a class="btn btn--primary" href={url(`/zakazivanje?usluga=${service.id}`)}>Zakažite termin</a>
    </div>
  </PageHeader>

  <section class="section">
    <div class="container with-aside">
      <div class="detail">
        <div class="prose detail__text">
          {bodyHtml ? <Fragment set:html={bodyHtml} /> : <Content />}
        </div>
        <section class="detail__scope" aria-labelledby="sub-h">
          <h2 id="sub-h">Šta obuhvata</h2>
          <ul class="check-list check-list--2">
            {service.data.subservices.map((x) => <li>{x}</li>)}
          </ul>
        </section>

        {service.data.faqs.length > 0 && (
          <section class="detail__faq" aria-labelledby="faq-h">
            <h2 id="faq-h">Česta pitanja</h2>
            <div class="faq-group">
              {service.data.faqs.map((f) => (
                <details class="faq">
                  <summary>{f.q}</summary>
                  <p>{f.a}</p>
                </details>
              ))}
            </div>
          </section>
        )}
      </div>

      <aside class="panel panel--tint booking-panel" aria-labelledby="book-h">
        <h2 id="book-h">Zakažite termin</h2>
        <p>Pošaljite zahtev online, a ordinacija vas kontaktira i potvrđuje termin.</p>
        <a class="btn btn--primary booking-panel__btn" href={url(`/zakazivanje?usluga=${service.id}`)}>Zakažite termin</a>
        <ul class="check-list booking-panel__facts">
          <li>U lokalnoj anesteziji, uz gel pre uboda</li>
          <li>Pre zahvata objasnimo šta radimo i zašto</li>
        </ul>
        <h3 class="booking-panel__sub">Radno vreme</h3>
        <HoursTable showSpecial={false} />
        <p class="booking-panel__addr"><a href={practice.mapsUrl} rel="noopener">{addressLine()}</a></p>
      </aside>
    </div>
  </section>

  <section class="section section--tint others" aria-labelledby="other-h">
    <div class="container">
      <h2 id="other-h">Ostale usluge</h2>
      <ServiceGrid items={others} compact />
      <a class="btn btn--secondary" href={url('/usluge')}>Pregled svih usluga</a>
    </div>
  </section>
</Base>
<style>
  .detail { display: grid; gap: var(--space-2xl); }
  .detail__text { font-size: var(--text-lg); line-height: 1.65; }
  .detail__text :global(h2) { font-size: var(--text-2xl); font-weight: var(--display-weight); margin: var(--space-2xl) 0 var(--space-md); }
  .detail__text :global(ul) { margin-top: var(--space-md); }
  .detail__scope h2, .detail__faq h2 { font-size: var(--text-2xl); font-weight: var(--display-weight); margin-bottom: var(--space-lg); }
  .check-list--2 { grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); column-gap: var(--gap-columns); }
  .booking-panel { display: grid; gap: var(--space-md); }
  .booking-panel h2 { font-size: var(--text-2xl); font-weight: var(--display-weight); }
  .booking-panel p { color: var(--color-ink-2); }
  .booking-panel__btn { width: 100%; }
  .booking-panel__facts { font-size: var(--text-md); }
  .booking-panel__sub { font-size: var(--text-md); margin-top: var(--space-xs); }
  .booking-panel :global(.hours-table) { font-size: var(--text-sm); max-width: none; }
  .booking-panel__addr { font-size: var(--text-sm); }
  .booking-panel__addr a { color: var(--color-muted); }
  .others h2 { margin-bottom: var(--space-xl); }
  .others .btn { margin-top: var(--space-xl); }
</style>
