---
import { url } from '../../lib/url';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import CtaBand from '../../components/CtaBand.astro';
import { breadcrumbJsonLd } from '../../lib/schema';
import { practice } from '../../lib/practice';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const crumbs = [{ name: 'Početna', path: '/' }, { name: 'Usluge', path: '/usluge' }];
const site = Astro.site ?? new URL(Astro.url.origin);
---
<Base
  title={`Stomatološke usluge – ${practice.address.city}`}
  description={`Usluge ordinacije ${practice.name} ${practice.locative}: pregledi, plombe, lečenje kanala, vađenje zuba, proteze, lečenje desni i beljenje zuba.`}
  jsonLd={[breadcrumbJsonLd(site, crumbs)]}
>
  <PageHeader title={`Stomatološke usluge ${practice.locative}`} lead="Opšta stomatologija za odrasle i decu, sve u lokalnoj anesteziji." crumbs={crumbs} />

  <section class="section">
    <div class="container">
      <ol class="service-list">
        {services.map((s, i) => (
          <li class="service-item">
            <span class="service-item__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div class="service-item__body">
              <h2><a href={url(`/usluge/${s.id}`)}>{s.data.title}</a></h2>
              <p>{s.data.summary}</p>
              <ul class="chips">
                {s.data.subservices.slice(0, 5).map((x) => <li>{x}</li>)}
                {s.data.subservices.length > 5 && <li class="chips__more">+{s.data.subservices.length - 5}</li>}
              </ul>
            </div>
            <span class="service-item__arrow" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6" /></svg></span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {practice.notOffered.length > 0 && (
    <section class="section section--tint" aria-labelledby="not-h">
      <div class="container not-offered">
        <div>
          <h2 id="not-h">Šta ne radimo</h2>
          <p>Da biste odmah znali na čemu ste: sledeće tretmane ne radimo, ali vas rado upućujemo kolegama specijalistima.</p>
        </div>
        <ul class="not-list">
          {practice.notOffered.map((n) => (
            <li>
              <h3>{n.name}</h3>
              <p>{n.note}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <CtaBand
    title="Niste sigurni koja vam usluga treba?"
    text="Zakažite pregled. Doktorka će vam objasniti stanje zuba i predložiti terapiju pre nego što bilo šta počne."
  />
</Base>
<style>
  /* The services as an index: number, name and scope, then the parts as plain tags. One row per service, the row is the link. */
  .service-list { list-style: none; padding: 0; margin: 0; border-top: var(--rule-hair) solid var(--color-ink); }
  .service-item {
    position: relative; display: grid; gap: var(--space-xs) var(--gap-columns); padding-block: var(--space-xl);
    border-bottom: var(--rule-hair) solid var(--color-rule); transition: background-color var(--dur-short) var(--ease-out);
  }
  .service-item:hover { background: var(--color-paper-2); }
  @media (min-width: 60rem) { .service-item { grid-template-columns: minmax(0, 1fr) minmax(0, 10fr) auto; align-items: start; } }
  .service-item__num { font-size: var(--text-title); font-weight: 300; color: var(--color-accent); line-height: 1.2; font-variant-numeric: tabular-nums; }
  .service-item h2 { font-size: var(--text-2xl); font-weight: var(--display-weight); margin-bottom: var(--space-xs); }
  .service-item h2 a { color: var(--color-ink); text-decoration: none; }
  .service-item h2 a::after { content: ''; position: absolute; inset: 0; }
  .service-item h2 a:focus-visible { outline: none; }
  .service-item h2 a:focus-visible::after { outline: 2px solid var(--color-focus); outline-offset: -2px; }
  .service-item:hover h2 a { color: var(--color-accent); }
  .service-item p { color: var(--color-muted); max-width: 62ch; margin-bottom: var(--space-md); }
  .service-item__arrow { display: none; width: 48px; height: 48px; border-radius: var(--radius-pill); border: 1.5px solid var(--color-ink); place-items: center; color: var(--color-ink); }
  @media (min-width: 60rem) { .service-item__arrow { display: grid; } }
  .service-item:hover .service-item__arrow { background: var(--color-accent); border-color: var(--color-accent); color: var(--color-accent-ink); }
  .service-item__arrow svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .chips { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: var(--space-xs); }
  .chips li { padding: var(--space-2xs) var(--space-sm); border-radius: var(--radius-inner); background: var(--color-paper-3); font-size: var(--text-sm); color: var(--color-ink); }
  .not-offered { display: grid; gap: var(--space-xl); }
  @media (min-width: 60rem) { .not-offered { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--space-3xl); align-items: start; } }
  .not-offered > div > p { color: var(--color-muted); margin-top: var(--space-md); max-width: 44ch; }
  .not-list { list-style: none; padding: 0; margin: 0; border-top: var(--rule-hair) solid var(--color-rule); }
  .not-list li { padding-block: var(--space-lg); border-bottom: var(--rule-hair) solid var(--color-rule); }
  .not-list h3 { font-size: var(--text-title); margin-bottom: var(--space-2xs); }
  .not-list p { color: var(--color-muted); }
</style>
