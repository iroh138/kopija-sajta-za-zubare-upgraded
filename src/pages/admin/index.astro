---
import { url, IS_STATIC_PREVIEW } from '../../lib/url';
// Server-rendered. The static GitHub Pages preview prerenders it instead (see astro.config.mjs).
export const prerender = false;

import { getCollection } from 'astro:content';
import { listRequests, updateStatus, deleteRequest, purgeOldRequests, STATUSES, type Status } from '../../lib/db';
import { TIME_OPTIONS, CONTACT_OPTIONS } from '../../lib/booking';
import { practice } from '../../lib/practice';

if (!IS_STATIC_PREVIEW && Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const id = Number(form.get('id'));
  const status = String(form.get('status')) as Status;
  if (form.get('action') === 'delete') {
    if (Number.isInteger(id) && form.get('confirm') === 'da') deleteRequest(id);
  } else if (Number.isInteger(id) && STATUSES.includes(status)) updateStatus(id, status);
  const back = String(form.get('filter') ?? '');
  const query = STATUSES.includes(back as Status) ? `?status=${back}` : '';
  return Astro.redirect(url('/admin') + query, 303);
}

if (!IS_STATIC_PREVIEW) purgeOldRequests();
const retentionDays = Number(process.env.REQUEST_RETENTION_DAYS ?? 90) || 90;
const filterParam = Astro.url.searchParams.get('status');
const filter = STATUSES.includes(filterParam as Status) ? (filterParam as Status) : undefined;
const rows = IS_STATIC_PREVIEW ? [] : listRequests(filter);
const all = IS_STATIC_PREVIEW ? [] : listRequests();
const counts = Object.fromEntries(STATUSES.map((s) => [s, all.filter((r) => r.status === s).length]));
const serviceNames = Object.fromEntries((await getCollection('services')).map((s) => [s.id, s.data.title]));
const statusLabel: Record<string, string> = { new: 'novi', contacted: 'kontaktiran', booked: 'zakazan', closed: 'zatvoren' };
const timeLabel = (v: string) => v.split(',').filter(Boolean).map((t) => TIME_OPTIONS.find((o) => o.value === t)?.label ?? t).join(', ') || '—';
const contactLabel = (v: string) => CONTACT_OPTIONS.find((o) => o.value === v)?.label ?? v;
const fmt = (iso: string) => new Date(iso).toLocaleString('sr-Latn-RS', { dateStyle: 'medium', timeStyle: 'short' });
---
<!doctype html>
<html lang="sr-Latn">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Zahtevi za termin · {practice.name}</title>
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
  </head>
  <body>
    <main class="admin">
      <h1>Zahtevi za termin</h1>
      <p class="muted">Zakazani i zatvoreni zahtevi brišu se automatski posle {retentionDays} dana bez izmena. Novi i kontaktirani se ne brišu automatski. Na zahtev pacijenta podatke obrišite dugmetom „Obriši”.</p>
      {IS_STATIC_PREVIEW && <p><strong>Nije dostupno u preglednoj verziji.</strong> Spisak zahteva radi samo na pravom serveru.</p>}
      <nav class="filters" aria-label="Filter po statusu">
        <a href={url('/admin')} aria-current={!filter ? 'page' : undefined}>Svi ({all.length})</a>
        {STATUSES.map((s) => <a href={url(`/admin?status=${s}`)} aria-current={filter === s ? 'page' : undefined}>{statusLabel[s]} ({counts[s]})</a>)}
      </nav>
      {rows.length === 0 ? <p>Nema zahteva{filter ? ` sa statusom „${statusLabel[filter]}”` : ''}.</p> : (
        <div class="table-wrap">
          <table>
            <thead>
              <tr><th>#</th><th>Primljen</th><th>Pacijent</th><th>Kontakt</th><th>Razlog</th><th>Termin</th><th>Poruka</th><th>Status</th></tr>
            </thead>
            <tbody>
              {rows.map((r) => (
                <tr class:list={[`st-${r.status}`, { urgent: r.urgent }]}>
                  <td>{r.id}</td>
                  <td>{fmt(r.created_at)}</td>
                  <td>
                    <strong>{r.patient_name}</strong>{r.urgent ? <span class="urgent-tag">HITNO</span> : null}<br />
                    {r.patient_type === 'new' ? 'Prvi put' : 'Postojeći pacijent'}{r.patient_is_minor ? ` · maloletan, roditelj/staratelj: ${r.guardian_name}` : ''}
                  </td>
                  <td>
                    <a href={`tel:${r.phone}`}>{r.phone}</a>
                    {r.email && <><br /><a href={`mailto:${r.email}`}>{r.email}</a></>}
                    <br /><span class="muted">Želi: {contactLabel(r.preferred_contact)}</span>
                  </td>
                  <td>{r.service_interest ? serviceNames[r.service_interest] ?? r.service_interest : '—'}</td>
                  <td>{timeLabel(r.preferred_times)}</td>
                  <td>{r.message ?? '—'}</td>
                  <td>
                    <form method="post">
                      <input type="hidden" name="id" value={r.id} />
                      <input type="hidden" name="filter" value={filter ?? ''} />
                      <label class="visually-hidden" for={`st-${r.id}`}>Status zahteva {r.id}</label>
                      <select id={`st-${r.id}`} name="status">
                        {STATUSES.map((s) => <option value={s} selected={r.status === s}>{statusLabel[s]}</option>)}
                      </select>
                      <button type="submit">Sačuvaj</button>
                    </form>
                    <form method="post" class="del" data-confirm={`Obrisati zahtev #${r.id} (${r.patient_name})? Ovo se ne može poništiti.`}>
                      <input type="hidden" name="id" value={r.id} />
                      <input type="hidden" name="filter" value={filter ?? ''} />
                      <input type="hidden" name="action" value="delete" />
                      <label><input type="checkbox" name="confirm" value="da" required /> potvrđujem</label>
                      <button type="submit" class="danger">Obriši</button>
                    </form>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </main>
    <style is:global>
      /* Hallmark · shape: app screen · genre: modern-minimal · theme: brand · redesign: restyle
       * nav: the filter strip, kept · signature: the requests table, kept · states: new, contacted, booked, closed
       * axes: light/geometric-sans/chromatic-violet · contrast: pass · v2.0.0 */
      :root {
        --a-paper: oklch(98.6% 0.008 300); --a-paper-2: oklch(96.2% 0.018 300); --a-ink: oklch(21% 0.06 300); --a-muted: oklch(46% 0.04 300);
        --a-rule: oklch(89% 0.02 300); --a-edge: oklch(70% 0.03 300); --a-accent: oklch(50% 0.16 296); --a-accent-ink: oklch(98.6% 0.008 300);
        --a-focus: oklch(52% 0.2 296); --a-danger: oklch(52% 0.19 27); --a-urgent: oklch(97% 0.03 60); --a-urgent-tag: oklch(93% 0.05 25); --a-urgent-ink: oklch(42% 0.15 27);
        --a-font: system-ui, sans-serif;
        --a-1: 4px; --a-2: 8px; --a-3: 12px; --a-4: 16px; --a-6: 24px;
      }
      html, body { overflow-x: clip; }
      body { margin: 0; font: 15px/1.5 var(--a-font); color: var(--a-ink); background: var(--a-paper); }
      .admin { padding: var(--a-6); max-width: 90rem; margin: 0 auto; }
      h1 { margin: 0 0 var(--a-4); text-wrap: balance; }
      .filters { display: flex; flex-wrap: wrap; gap: var(--a-2); margin-bottom: var(--a-4); }
      .filters a { padding: var(--a-1) var(--a-3); border: 1px solid var(--a-edge); border-radius: 999px; color: var(--a-ink); text-decoration: none; }
      .filters a[aria-current='page'] { background: var(--a-accent); color: var(--a-accent-ink); border-color: var(--a-accent); }
      .filters a:focus-visible, button:focus-visible, select:focus-visible { outline: 2px solid var(--a-focus); outline-offset: 2px; }
      .table-wrap { overflow-x: auto; background: var(--a-paper); border: 1px solid var(--a-rule); border-radius: var(--a-2); }
      table { border-collapse: collapse; width: 100%; }
      th, td { text-align: left; vertical-align: top; padding: var(--a-2) var(--a-3); border-bottom: 1px solid var(--a-rule); }
      th { background: var(--a-paper-2); white-space: nowrap; }
      tr.st-new td:first-child { box-shadow: inset 4px 0 0 var(--a-accent); }
      .muted { color: var(--a-muted); }
      .urgent-tag { margin-left: var(--a-2); font-size: .8125rem; font-weight: 700; padding: 0 var(--a-2); border-radius: 999px; background: var(--a-urgent-tag); color: var(--a-urgent-ink); }
      tr.urgent td { background: var(--a-urgent); }
      form { display: flex; gap: var(--a-1); align-items: center; }
      form.del { margin-top: var(--a-2); font-size: .875rem; }
      button.danger { background: var(--a-danger); }
      select, button { font: inherit; padding: var(--a-1) var(--a-2); min-height: 32px; }
      button { background: var(--a-accent); color: var(--a-accent-ink); border: 0; border-radius: 6px; cursor: pointer; }
      button:active { transform: translateY(1px); }
      button:disabled { opacity: 0.55; cursor: not-allowed; }
      .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
    </style>
    <script>
      document.querySelectorAll('form[data-confirm]').forEach((f) =>
        f.addEventListener('submit', (e) => { if (!confirm(f.dataset.confirm)) e.preventDefault(); })
      );
    </script>
  </body>
</html>
