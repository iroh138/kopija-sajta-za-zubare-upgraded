---
import { url } from '../lib/url';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { breadcrumbJsonLd, faqJsonLd } from '../lib/schema';
import { practice } from '../lib/practice';
import faq from '../data/faq.json';

const crumbs = [{ name: 'Početna', path: '/' }, { name: 'Pitanja i odgovori', path: '/pitanja' }];
const site = Astro.site ?? new URL(Astro.url.origin);
---
<Base
  title={`Pitanja i odgovori – stomatolog ${practice.address.city}`}
  description={`Da li boli, kako se zakazuje, radi li ${practice.name} vikendom i preko osiguranja, koliko traje intervencija: odgovori na najčešća pitanja pacijenata.`}
  jsonLd={[breadcrumbJsonLd(site, crumbs), faqJsonLd(faq)]}
>
  <PageHeader title="Pitanja i odgovori" lead="Odgovori na pitanja koja nam pacijenti najčešće postavljaju." crumbs={crumbs} />
  <section class="section">
    <div class="container with-aside">
      <div class="faq-group">
        {faq.map((f, i) => (
          <details class="faq" open={i === 0}>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
      <aside class="aside-stack">
        <section class="panel panel--tint" aria-labelledby="pay-h">
          <h2 id="pay-h">Plaćanje</h2>
          <p>{practice.paymentNote}</p>
        </section>
        <section class="panel" aria-labelledby="ask-h">
          <h2 id="ask-h">Niste pronašli odgovor?</h2>
          <p>Pišite nam na <a href={`mailto:${practice.email}`}>{practice.email}</a> ili ostavite pitanje u obrascu za zakazivanje.</p>
          <a class="btn btn--primary" href={url('/zakazivanje')}>Zakažite termin online</a>
        </section>
      </aside>
    </div>
  </section>
</Base>
<style>
  .aside-stack { display: grid; gap: var(--space-md); }
  .aside-stack .btn { width: 100%; }
  .aside-stack p { color: var(--color-ink-2); }
</style>
