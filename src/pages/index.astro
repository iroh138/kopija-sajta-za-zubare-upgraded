---
import { url, IS_STATIC_PREVIEW } from '../lib/url';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import LocationBlock from '../components/LocationBlock.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import Reasons from '../components/Reasons.astro';
import { practice } from '../lib/practice';
import faq from '../data/faq.json';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const featured = services.filter((s) => s.data.featuredOnHome);
const lead = (await getCollection('staff')).sort((a, b) => a.data.order - b.data.order)[0];
const doctorName = lead ? `${lead.data.honorific ? lead.data.honorific + ' ' : ''}${lead.data.name}` : '';

// Reviews: real, consented, verbatim ones everywhere; a paraphrase awaiting the exact text only in the preview, labelled.
const reviews = (await getCollection('testimonials'))
  .filter((t) => t.data.consentRecorded && t.data.source && (t.data.verbatim || IS_STATIC_PREVIEW))
  .map((t) => t.data);

const gallery = [
  { src: '/images/ordinacija-1.webp', alt: 'Stomatološka stolica i radno mesto u ordinaciji 3A DENT', caption: 'Radno mesto i stomatološka stolica' },
  { src: '/images/ordinacija-2.webp', alt: 'Stomatološka jedinica sa ekranom u ordinaciji', caption: 'Stomatološka jedinica sa ekranom' },
];

// The week as a strip (the page's signature): every day from practice.json, evenings marked.
const SHORT = ['Pon', 'Uto', 'Sre', 'Čet', 'Pet', 'Sub', 'Ned'];
const week = practice.hours.map((h: any) => ({
  day: h.day,
  short: SHORT[h.day - 1],
  closed: !!h.closed,
  opens: h.closed ? '' : h.opens.replace(/:00$/, ''),
  closes: h.closed ? '' : h.closes.replace(/:00$/, ''),
  evening: !h.closed && Number(h.closes.slice(0, 2)) >= 20,
}));

const homeFaq = faq.slice(0, 4);
const { city } = practice.address;
---
<Base
  title={`Stomatolog i zubar ${city} | ${practice.name}`}
  description={`Stomatološka ordinacija ${practice.name}, ${practice.address.street}, ${city}. Plombe, lečenje kanala, vađenje zuba i čišćenje kamenca, bez bola. Zakažite online.`}
>
  <!-- Hero: Stage. The head and the booking on the left, the doctor and the week on the right. -->
  <section class="hero" aria-labelledby="hero-h">
    <div class="container hero__grid">
      <div class="hero__text">
        <h1 id="hero-h"><span class="hero__line">Zubar bez straha</span> <span class="hero__line">na Novom Beogradu</span></h1>
        <p class="lead">Sve radimo u anesteziji, uz gel pre uboda. <span class="nowrap">{practice.address.street}</span>.</p>
        <div class="btn-row">
          <a class="btn btn--primary" href={url('/zakazivanje')}>Zakažite termin</a>
          <a class="btn btn--secondary" href={url('/usluge')}>Pogledajte usluge</a>
        </div>
      </div>
      <figure class="hero__visual">
        <div class="hero__frame">
          <video class="hero__photo" id="hero-video" muted loop playsinline preload="metadata" width="1000" height="800"
                 poster={url('/images/hero-loop-poster.webp')} aria-label={`${doctorName} u ordinaciji ${practice.name}, pa kratak prolaz kroz ordinaciju`}>
            <source src={url('/video/hero-loop.mp4')} type="video/mp4" />
          </video>
          <button type="button" class="video-toggle hero__toggle" data-hero-toggle aria-pressed="false">
            <span class="visually-hidden" data-label>Pusti video</span>
            <svg class="icon-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
            <svg class="icon-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5h4v14H7zM13 5h4v14h-4z" /></svg>
          </button>
        </div>
        <figcaption class="week" aria-label="Radno vreme ove nedelje">
          <ol class="week__days" data-nap="hours">
            {week.map((d) => (
              <li class:list={['week__day', { 'is-closed': d.closed, 'is-evening': d.evening }]} data-day={d.day}>
                <span class="week__name">{d.short}</span>
                <span class="week__time">{d.closed ? 'zatvoreno' : `${d.opens} do ${d.closes}`}</span>
              </li>
            ))}
          </ol>
          <p class="week__note">Ponedeljkom, sredom i petkom radimo do 21 h.</p>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- The room: the walk-through video set large, two photographs beside it. -->
  <section class="section room" aria-labelledby="office-h">
    <div class="container">
      <div class="section-head section-head--split" data-reveal>
        <h2 id="office-h">Prostor u kom se osećate opušteno</h2>
        <p>Svetla, uredna ordinacija sa savremenom stomatološkom jedinicom. Sve intervencije izvodimo u sterilnim uslovima.</p>
      </div>
      <div class="room__grid" data-reveal>
        <div class="room__video">
          <video id="office-video" poster={url('/images/video-poster.webp')} muted loop playsinline preload="none" width="720" height="880" aria-label="Kratak video šetnje kroz ordinaciju">
            <source src={url('/video/ordinacija.webm')} type="video/webm" />
            <source src={url('/video/ordinacija.mp4')} type="video/mp4" />
          </video>
          <button type="button" class="video-toggle" data-video-toggle aria-pressed="false">
            <span class="visually-hidden" data-label>Pusti video</span>
            <svg class="icon-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
            <svg class="icon-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5h4v14H7zM13 5h4v14h-4z" /></svg>
          </button>
        </div>
        {gallery.map((g) => (
          <figure class="room__photo">
            <img src={url(g.src)} alt={g.alt} width="900" height="900" loading="lazy" decoding="async" />
            <figcaption>{g.caption}</figcaption>
          </figure>
        ))}
      </div>
      <p class="room__link"><a class="text-link" href={url('/kontakt')}>Kako do nas</a></p>
    </div>
  </section>

  <!-- The services, set as the clinic's menu. -->
  <section class="section section--tint section--l" aria-labelledby="services-h">
    <div class="container">
      <div class="section-head section-head--split" data-reveal>
        <h2 id="services-h">Kompletna nega zuba na jednom mestu</h2>
        <p>Implante i ortodonciju ne radimo; za te tretmane vas upućujemo proverenim kolegama specijalistima.</p>
      </div>
      <div data-reveal><ServiceGrid items={featured} /></div>
      <div class="services__more">
        <a class="btn btn--secondary" href={url('/usluge')}>Sve usluge</a>
      </div>
    </div>
  </section>

  <!-- The doctor: her portrait beside how the practice works. -->
  <section class="section section--l" aria-labelledby="intro-h">
    <div class="container doctor">
      {lead?.data.photo && (
        <div class="arch doctor__photo">
          <img src={url(lead.data.photo.src)} alt={lead.data.photo.alt} width={lead.data.photo.width} height={lead.data.photo.height} loading="lazy" decoding="async" />
        </div>
      )}
      <div class="doctor__body" data-reveal>
        <h2 id="intro-h">Zubar kojeg ćete voleti</h2>
        <p class="lead">{lead && <>Ordinaciju vodi <a href={url('/o-nama')}>{doctorName}</a>, doktor opšte stomatologije, već {practice.yearsActive} godina. </>}Kod nas i najplašljiviji pacijenti savladaju strah.</p>
        <Reasons min="15rem" />
        <a class="btn btn--secondary" href={url('/o-nama')}>Upoznajte doktorku</a>
      </div>
    </div>
  </section>

  {reviews.length > 0 && (
    <section class="section section--tint" aria-labelledby="reviews-h">
      <div class="container">
        <h2 id="reviews-h" class="visually-hidden">Utisci pacijenata</h2>
        {reviews.map((t) => (
          <figure class="quote">
            {t.rating && (
              <p class="quote__stars" role="img" aria-label={`Ocena ${t.rating} od 5`}>
                {Array.from({ length: 5 }, (_, i) => (
                  <svg viewBox="0 0 24 24" aria-hidden="true" class:list={[{ off: i >= (t.rating ?? 0) }]}><path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3 6.1 20.6l1.3-6.6L2.5 9.4l6.6-.8z" /></svg>
                ))}
              </p>
            )}
            <blockquote><p>{t.body}</p></blockquote>
            <figcaption>
              {t.author}
              {!t.verbatim && <span class="quote__tag">Parafraza, za proveru</span>}
            </figcaption>
          </figure>
        ))}
      </div>
    </section>
  )}

  <!-- Questions: the head on the left, the answers on the right. -->
  <section class="section" aria-labelledby="faq-h">
    <div class="container faq-split" data-reveal>
      <div class="faq-split__head">
        <h2 id="faq-h">Pitanja i odgovori</h2>
        <p>{practice.paymentNote}</p>
        <a class="text-link" href={url('/pitanja')}>Sva pitanja</a>
      </div>
      <div class="faq-group">
        {homeFaq.map((f) => (
          <details class="faq">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- The close: what the visitor came to do. Where, when, and the booking. -->
  <section class="section section--tint section--l" aria-labelledby="cta-h">
    <div class="container">
      <div class="section-head section-head--split" data-reveal>
        <h2 id="cta-h">Plašite se zubara?</h2>
        <p>Radimo polako, uz lokalnu anesteziju i objašnjenje svakog koraka. Zakažite prvi pregled.</p>
      </div>
      <div data-reveal><LocationBlock headingLevel="h3" /></div>
    </div>
  </section>
</Base>

<script>
  // Hero loop: plays only when motion is allowed and the hero is on screen; the button always pauses it.
  // Without JS or with reduced motion the poster (the doctor) stays.
  {
    const hv = document.getElementById('hero-video') as HTMLVideoElement | null;
    const hb = document.querySelector<HTMLButtonElement>('[data-hero-toggle]');
    const hl = hb?.querySelector('[data-label]');
    const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let paused = still;
    const show = () => { const on = !!hv && !hv.paused; hb?.setAttribute('aria-pressed', String(on)); if (hl) hl.textContent = on ? 'Pauziraj video' : 'Pusti video'; };
    hv?.addEventListener('play', show); hv?.addEventListener('pause', show);
    hb?.addEventListener('click', () => { if (!hv) return; if (hv.paused) { paused = false; hv.play().catch(() => {}); } else { paused = true; hv.pause(); } });
    if (hv && 'IntersectionObserver' in window) {
      new IntersectionObserver(([e]) => { if (e.isIntersecting && !paused) hv.play().catch(() => {}); else if (!e.isIntersecting) hv.pause(); }, { threshold: 0.25 }).observe(hv);
    }
  }

  // Mark today in the week strip (progressive: the strip reads the same without it).
  const today = ((new Date().getDay() + 6) % 7) + 1;
  document.querySelector(`.week__day[data-day="${today}"]`)?.classList.add('is-today');

  // Video plays only on request or when in view (and never with reduced motion); always pausable.
  const video = document.getElementById('office-video') as HTMLVideoElement | null;
  const btn = document.querySelector<HTMLButtonElement>('[data-video-toggle]');
  const label = btn?.querySelector('[data-label]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const sync = () => {
    const playing = !!video && !video.paused;
    btn?.setAttribute('aria-pressed', String(playing));
    if (label) label.textContent = playing ? 'Pauziraj video' : 'Pusti video';
  };
  let userPaused = false;
  btn?.addEventListener('click', () => {
    if (!video) return;
    if (video.paused) { userPaused = false; video.play(); } else { userPaused = true; video.pause(); }
  });
  video?.addEventListener('play', sync);
  video?.addEventListener('pause', sync);
  if (video && !reduce && 'IntersectionObserver' in window) {
    new IntersectionObserver(([e]) => {
      if (e.isIntersecting && !userPaused) video.play().catch(() => {});
      else if (!e.isIntersecting) video.pause();
    }, { threshold: 0.4 }).observe(video);
  }
</script>

<style>
  /* Hero: Stage. Text on five columns, the visual on seven, centred in the screen under the nav. */
  .hero { padding-block: var(--space-xl) var(--space-2xl); }
  .hero__grid { display: grid; gap: var(--space-xl); align-items: center; }
  .hero__text { display: grid; gap: var(--space-lg); justify-items: start; }
  .hero__text h1 { font-size: clamp(2.75rem, 5.2vw, 5.25rem); max-width: none; line-height: 1.02; }
  .hero__line, .nowrap { display: inline-block; }
  .hero__text .lead { max-width: 34ch; }
  /* The photograph takes the brand's arch on its leading corner; the week card overlaps its foot (depth by layering). */
  .hero__visual { margin: 0; display: grid; gap: 0; }
  .hero__frame { position: relative; overflow: hidden; border-radius: var(--radius-arch) var(--radius-card) var(--radius-card) var(--radius-card); }
  .hero__photo { display: block; width: 100%; aspect-ratio: 5 / 4; object-fit: cover; object-position: 50% 30%; background: var(--color-paper-3); }
  .hero__toggle { top: var(--space-md); bottom: auto; }
  .hero__visual .week { position: relative; z-index: var(--z-raised); margin: calc(-1 * var(--space-2xl)) var(--space-md) 0; border-color: transparent; box-shadow: var(--shadow-lift); }

  /* Entrance: one settle, 0.8s in all. Self-running CSS, so the hero is never blank without JS; reduced motion shows the end state. */
  @keyframes rise { from { opacity: 0; transform: translateY(16px); filter: blur(6px); } to { opacity: 1; transform: none; filter: none; } }
  @keyframes settle { from { transform: scale(1.05); } to { transform: none; } }
  .hero__text > *, .hero__visual .week { animation: rise var(--dur-entrance) var(--ease-out) both; }
  .hero__text > :nth-child(2) { animation-delay: 60ms; }
  .hero__text > :nth-child(3) { animation-delay: 120ms; }
  .hero__visual .week { animation-delay: 180ms; }
  .hero__photo { animation: settle var(--dur-entrance) var(--ease-out) both; }
  @media (min-width: 64rem) {
    .hero { min-height: calc(100svh - var(--header-h)); display: grid; align-items: center; padding-block: var(--space-xl); }
    .hero__grid { grid-template-columns: minmax(0, 6fr) minmax(0, 6fr); gap: var(--space-2xl); }
    .hero__photo { aspect-ratio: auto; height: clamp(22rem, 56svh, 38rem); }
  }

  /* The week strip: the signature. Seven cells, the evenings in the accent, today outlined. */
  .week { background: var(--color-paper); border: var(--rule-hair) solid var(--color-rule); border-radius: var(--radius-card); padding: var(--space-md); display: grid; gap: var(--space-sm); }
  .week__days { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: var(--space-2xs); font-variant-numeric: tabular-nums; }
  .week__day { display: grid; gap: var(--space-3xs); padding: var(--space-xs); border-radius: var(--radius-inner); background: var(--color-paper-2); text-align: center; }
  .week__name { font-size: var(--text-sm); color: var(--color-muted); }
  .week__time { font-size: var(--text-sm); font-weight: var(--weight-strong); color: var(--color-ink); line-height: 1.25; }
  .week__day.is-evening .week__time { color: var(--color-accent); }
  .week__day.is-closed { background: transparent; }
  .week__day.is-closed .week__time { font-weight: 400; color: var(--color-muted); }
  .week__day.is-today { outline: 2px solid var(--color-ink); outline-offset: -2px; }
  .week__note { font-size: var(--text-sm); color: var(--color-ink-2); }
  @media (max-width: 40rem) {
    .week__days { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .week__day { display: flex; justify-content: space-between; align-items: baseline; text-align: left; padding: var(--space-xs) var(--space-sm); }
  }

  /* The room: video on eight columns, two photographs stacked on four. */
  .room__grid { display: grid; gap: var(--gap-columns); }
  .room__video { position: relative; border-radius: var(--radius-card); overflow: hidden; background: var(--color-paper-3); aspect-ratio: 4 / 5; }
  .room__video video { width: 100%; height: 100%; object-fit: cover; }
  .room__photo { margin: 0; display: grid; gap: var(--space-xs); }
  .room__photo img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--radius-card); }
  .room__photo figcaption { font-size: var(--text-sm); color: var(--color-muted); }
  .room__link { margin-top: var(--space-xl); }
  @media (min-width: 60rem) {
    .room__grid { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); grid-template-rows: auto auto; }
    .room__video { grid-row: span 2; aspect-ratio: auto; min-height: 36rem; }
  }
  .video-toggle {
    position: absolute; right: var(--space-md); bottom: var(--space-md); width: 48px; height: 48px; border-radius: var(--radius-pill); border: 0; cursor: pointer;
    display: grid; place-items: center; background: var(--color-paper); color: var(--color-ink);
    transition: background-color var(--dur-short) var(--ease-out);
  }
  .video-toggle:hover { background: var(--color-paper-3); }
  .video-toggle:focus-visible { outline: 2px solid var(--color-focus); outline-offset: 3px; }
  .video-toggle svg { width: 24px; height: 24px; grid-area: 1 / 1; fill: currentColor; }
  .video-toggle .icon-pause, .video-toggle[aria-pressed='true'] .icon-play { display: none; }
  .video-toggle[aria-pressed='true'] .icon-pause { display: block; }

  .services__more { margin-top: var(--space-xl); }

  /* The doctor: arched portrait on five columns, the approach on seven. */
  .doctor { display: grid; gap: var(--space-2xl); align-items: center; }
  .doctor__photo { aspect-ratio: 3 / 4; max-width: 30rem; width: 100%; }
  .doctor__body { display: grid; gap: var(--space-xl); justify-items: start; }
  .doctor__body .lead { max-width: 44ch; }
  .doctor__body :global(.reasons) { width: 100%; margin: 0; }
  @media (min-width: 60rem) { .doctor { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--space-3xl); } }

  /* One patient's words, set as a statement. */
  .quote { margin: 0; display: grid; gap: var(--space-xl); }
  .quote blockquote { margin: 0; }
  .quote blockquote p { font-family: var(--font-display); font-size: var(--text-section); font-weight: var(--display-weight); line-height: 1.15; letter-spacing: var(--tracking-display); color: var(--color-ink); max-width: 30ch; text-wrap: balance; }
  .quote figcaption { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-sm); font-weight: var(--weight-strong); }
  .quote__stars { display: flex; gap: var(--space-3xs); }
  .quote__stars svg { width: 24px; height: 24px; fill: var(--color-star); }
  .quote__stars svg.off { fill: var(--color-rule); }
  .quote__tag { font-size: var(--text-sm); font-weight: 400; padding: var(--space-3xs) var(--space-xs); border-radius: var(--radius-inner); background: var(--color-notice); color: var(--color-notice-ink); }

  /* Questions: head on four columns, answers on eight. */
  .faq-split { display: grid; gap: var(--space-xl); align-items: start; }
  .faq-split__head { display: grid; gap: var(--space-md); justify-items: start; }
  .faq-split__head p { color: var(--color-muted); max-width: 40ch; }
  @media (min-width: 60rem) { .faq-split { grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: var(--space-3xl); } }
</style>
