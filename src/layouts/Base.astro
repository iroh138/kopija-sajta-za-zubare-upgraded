---
import { url, abs, IS_STATIC_PREVIEW } from '../lib/url';
import '../styles/global.css';
import jost300 from '@fontsource/jost/files/jost-latin-300-normal.woff2?url';
import jost400 from '@fontsource/jost/files/jost-latin-400-normal.woff2?url';
import jost300ext from '@fontsource/jost/files/jost-latin-ext-300-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import { practice } from '../lib/practice';
import { practiceJsonLd, websiteJsonLd, ld } from '../lib/schema';
import { getCollection } from 'astro:content';

interface Props {
  title: string;
  description: string;
  /** Extra JSON-LD objects for this page (breadcrumbs, FAQ, article...). */
  jsonLd?: unknown[];
  noindex?: boolean;
  ogImage?: string;
}
const { title, description, jsonLd = [], noindex = false, ogImage = '/og-default.png' } = Astro.props;
const site = Astro.site ?? new URL(Astro.url.origin);
const canonical = abs(Astro.url.pathname, site);
const fullTitle = title.includes(practice.name) ? title : `${title} | ${practice.name}`;
const serviceLinks = (await getCollection('services'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((s) => ({ slug: s.id, name: s.data.shortTitle ?? s.data.title }));
const staffLinks = (await getCollection('staff')).map((s) => ({ slug: s.id, name: `${s.data.honorific ? s.data.honorific + ' ' : ''}${s.data.name}` }));
const isHome = (Astro.url.pathname.replace(/\/$/, '') || '/') === (url('/').replace(/\/$/, '') || '/');
const blocks = [practiceJsonLd(site, { services: serviceLinks, staff: staffLinks }), ...(isHome ? [websiteJsonLd(site)] : []), ...jsonLd.filter(Boolean)];
---
<!doctype html>
<html lang="sr-Latn">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href={jost300} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={jost400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={jost300ext} as="font" type="font/woff2" crossorigin />
    {(noindex || IS_STATIC_PREVIEW) && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#4b4164" />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="sr_RS" />
    <meta property="og:site_name" content={practice.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={abs(ogImage, site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    {blocks.map((b) => <script type="application/ld+json" set:html={ld(b)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Preskoči na sadržaj</a>
    {IS_STATIC_PREVIEW && (
      <div class="preview-banner" role="region" aria-label="Pregledna verzija">Pregledna verzija sajta. Online zakazivanje je u ovoj verziji isključeno.</div>
    )}
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <MobileBar />
    <ConsentBanner />
  </body>
</html>
<style is:global>
  html, body { overflow-x: clip; }
</style>
<style>
  .preview-banner { background: var(--color-notice); color: var(--color-notice-ink); text-align: center; padding: var(--space-xs) var(--space-md); font-size: var(--text-sm); font-weight: var(--weight-strong); }
</style>
